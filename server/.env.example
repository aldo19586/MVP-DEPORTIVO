PORT=3001
NODE_ENV=development
# Configurar un secreto aleatorio de al menos 32 bytes antes de usar test/production.
# Sin secreto en desarrollo se genera uno temporal; reiniciar invalida sesiones.
JWT_SECRET=
CORS_ORIGIN=*

# Pasar estas variables al proceso (este archivo no se carga automáticamente).
# Rutas relativas resueltas desde la raíz del repositorio.
MATCHSPORT_DB_PATH=matchsport.db
# Nunca sembrar demos al arrancar salvo petición explícita en desarrollo.
MATCHSPORT_SEED_DEMO=false
