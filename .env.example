# ==============================================================================
# MatchSport MVP - Plantilla de Variables de Entorno (Piloto y Producción)
# ==============================================================================
# Copia este archivo a `.env` y asigna valores reales antes de iniciar el servidor.
# NUNCA subas archivos `.env` con secretos o credenciales reales al repositorio.

# ------------------------------------------------------------------------------
# 1. Configuración del Servidor Backend (server/)
# ------------------------------------------------------------------------------
# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=production

# Puerto HTTP / WebSockets del proceso backend
PORT=3001

# Interfaz de red: '0.0.0.0' para escuchar en todas las interfaces o '127.0.0.1' tras proxy Nginx/Caddy
HOST=0.0.0.0

# Secreto criptográfico HMAC SHA-256 para firma y verificación de tokens JWT.
# OBLIGATORIO en entornos fuera de desarrollo. Debe tener al menos 32 bytes de entropía.
# Generación recomendada en terminal: openssl rand -hex 32
JWT_SECRET=reemplazar_con_secreto_criptografico_de_al_menos_32_caracteres_hexadecimales

# Ruta al archivo de almacenamiento SQLite durable.
# En instancias de hosting (Render, Railway, VPS), debe apuntar a un volumen persistente montado.
MATCHSPORT_DB_PATH=./matchsport.db

# Inyección de usuarios demo en el arranque.
# En 'production' DEBE ser 'false' (el servidor falla cerrado si se intenta sembrar demos en producción).
MATCHSPORT_SEED_DEMO=false

# Configuración de CORS para orígenes web permitidos.
# Separar múltiples orígenes por coma o usar '*' si está restringido por proxy inverso.
CORS_ORIGIN=https://admin.matchsport.app,https://matchsport.app

# URL pública oficial del backend (usada para referencias y webhooks)
PUBLIC_URL=https://api.matchsport.app

# ------------------------------------------------------------------------------
# 2. Configuración de la App Móvil (apps/mobile/)
# ------------------------------------------------------------------------------
# URL del backend para el cliente nativo Expo / React Native.
# En desarrollo local: se detecta automáticamente la IP de la LAN a través de Metro.
# En build de staging/piloto/producción (EAS Build / export):
EXPO_PUBLIC_API_URL=https://api.matchsport.app

# ------------------------------------------------------------------------------
# 3. Configuración del Panel SuperAdmin (apps/admin-web/)
# ------------------------------------------------------------------------------
# URL del backend para el cliente web de escritorio (React + Vite).
# Si el panel se sirve desde el mismo dominio bajo '/api', se puede omitir o dejar vacío.
VITE_API_URL=https://api.matchsport.app
VITE_SOCKET_URL=https://api.matchsport.app
