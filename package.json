{
  "name": "matchmaking-deportivo-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node server/server.js",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
